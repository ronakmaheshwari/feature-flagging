// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum USER_STATUS {
  ACTIVE
  DELETED
  UNVERIFIED
  LOCKED
}

enum STATUS_TYPE {
  DRAFT
  POSTED
  DELETED
}

enum ENVIRONMENT_TYPE {
  PRODUCTION
  DEVELOPMENT
}

enum OTP_TYPE {
  FORGET_PASSWORD
  VERIFICATION
}

enum ROLES {
  USER
  ADMIN
}

enum Method {
  GET
  POST
  PATCH
  PUT
  DELETE
  OPTIONS
  HEAD
  
}

model User {
  id                     String               @id @default(uuid())
  username               String
  email                  String               @unique
  password               String
  user_status            USER_STATUS          @default(UNVERIFIED)
  role                   ROLES                @default(USER)
  resetPasswordToken     String?              @unique
  resetPasswordOtpExpire DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  otp                    Otp?
  jwt_token              JWT_Token?
  content                Content[]
  group                  Group[]
  memberships            GroupMember[]
  feature_flag_audit     Feature_Flag_Audit[] @relation("UpdatedBy")

  @@index([email])
}

model Otp {
  id            String   @id @default(uuid())
  userId        String   @unique
  otp           String
  otpExpireTime DateTime
  isUsed        Boolean  @default(false)
  type          OTP_TYPE @default(VERIFICATION)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model JWT_Token {
  id          String   @id @default(uuid())
  userId      String   @unique
  token       String
  tokenExpire DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Content {
  id            String         @id @default(uuid())
  userId        String
  topic         String?
  content       String
  platform      String?
  isDeleted     Boolean        @default(false)
  status        STATUS_TYPE    @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  content_audit ContentAudit[]

  @@index([userId])
}

model ContentAudit {
  id         String   @id @default(uuid())
  contentId  String
  old_value  Json
  new_value  Json
  changed_at DateTime @default(now())
  content    Content  @relation(fields: [contentId], references: [id])

  @@index([contentId])
}

model Group {
  id          String        @id @default(uuid())
  name        String        @unique
  total_users Int
  userId      String
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  members     GroupMember[]

  @@index([name, userId])
}

model GroupMember {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

model Feature_Flag {
  id                 String               @id @default(uuid())
  name               String               @unique
  is_enabled         Boolean              @default(false)
  environment        ENVIRONMENT_TYPE     @default(DEVELOPMENT)
  rules              Json                 @default("{}")
  rollout            Int                  @default(100)
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  feature_flag_audit Feature_Flag_Audit[]
  routes            RouteFlag[]

  @@index([name])
}

model RouteFlag {
  id String @id @default(uuid())
  method Method
  path String
  flagName String
  feature_flag Feature_Flag @relation(fields: [flagName], references: [name])
  createdAt DateTime @default(now())

  @@unique([method, path])
}

model Feature_Flag_Audit {
  id           String       @id @default(uuid())
  flagId       String
  old_value    Json
  new_value    Json
  updatedBy    String?
  changed_at   DateTime     @default(now())
  user         User?        @relation("UpdatedBy", fields: [updatedBy], references: [id])
  feature_flag Feature_Flag @relation(fields: [flagId], references: [id])

  @@index([flagId, updatedBy])
}
